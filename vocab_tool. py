# 2.筛选函数：按HSK等级、词性筛选【作业1：列表推导式】
def filter_vocab(word_list, target_hsk, target_pos):
    # 作业1：使用列表推导式简化筛选
    res = [w for w in word_list if w["HSK等级"] == target_hsk and w["词性"] == target_pos]
    return res

# 3.统计函数
def count_info(word_list):
    total = len(word_list)
    pos_dict = {}
    for word in word_list:
        pos = word["词性"]
        如果 pos 在 pos_dict 中：
            pos_dict[pos] += 1
        else:
            pos_dict[pos] = 1
    return total, pos_dict

