import csv

# 1. 读取csv函数
def read_vocab(filepath):
    word_list = []
    with open(filepath, encoding="utf-8") as f:
        reader = csv.DictReader(f)
        for row in reader:
            word_list.append(row)
    return word_list

# 2. 筛选函数：按HSK等级、词性筛选
def filter_vocab(word_list, target_hsk, target_pos):
    # 使用列表推导式简化筛选
    res = [w for w in word_list if w["HSK等级"] == target_hsk and w["词性"] == target_pos]
    return res

